# renders and intermediates are rebuilt by the tools
**/frames/
**/renders/
**/review/*-vs-ref.*
node_modules/
__pycache__/
# built files (tools/build.mjs makes them from src/ + kit/ + the style)
plugins/**/index.html
plugins/**/review/
# your own work stays local: series bibles, scripts, cast and pieces are never pushed
/series/
/pieces/
/publish/
plugins/**/studio/dist/
.impeccable/
!plugins/**/studio/index.html
plugins/**/studio/tsconfig.tsbuildinfo
# local only: leftovers waiting to be deleted, and the Claude app's per-machine config
/_to_delete/
/.claude/
# realism lab: regression baselines and builds (tools/regress.mjs)
/_lab/
